# Database / Supabase Configuration
# Found in Supabase -> Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Your direct Postgres connection string (Required for certain operations)
DATABASE_URL=

# Gemini / LLM Configuration
# Get from Google AI Studio
GEMINI_API_KEY=
# Optional: override the Gemini model (default: gemini-2.5-flash)
GEMINI_MODEL=

# Backend Configuration
NODE_ENV=development
PORT=3000
# Strong random string for signing JWT tokens
JWT_SECRET=
# Log level (info, debug, warn, error)
LOG_LEVEL=info

# Meta WhatsApp Cloud API Configuration
# Found in Meta Developer Portal -> App Dashboard
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
# Arbitrary string used for webhook verification
META_VERIFY_TOKEN=

# App Configuration
# The cafe owner's WhatsApp number (must include country code, e.g., 919876543210)
SAM_WHATSAPP_TO=91XXXXXXXXXX
# Owner's email address for owner portal login
OWNER_EMAIL=

# CORS Configuration
# Comma-separated list of allowed frontend origins
FRONTEND_ORIGIN=http://localhost:5173
ALLOWED_FRONTEND_URL=http://localhost:5173
